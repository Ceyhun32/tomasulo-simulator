# Experiment-Trace: Gemischte Operationen
# Kombination aus ALU, MUL, DIV, LOAD, STORE mit verschiedenen Abhaengigkeiten
LOAD R1, 0(R0)
LOAD R2, 4(R0)
ADD R3, R1, R2
MUL R4, R3, R1
SUB R5, R2, R1
DIV R6, R4, R5
STORE R6, 8(R0)
ADD R7, R3, R5
MUL R0, R7, R6
LOAD R1, 12(R0)
ADD R2, R1, R7
SUB R3, R0, R2
DIV R4, R3, R1
STORE R4, 16(R0)
MUL R5, R4, R7
ADD R6, R5, R3
